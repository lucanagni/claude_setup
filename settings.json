{
  "env": {
    "CONDA_PKGS_DIRS": "/home/luca/.cache/conda-pkgs",
    "PIP_CACHE_DIR": "/home/luca/.cache/claude-pip"
  },
  "permissions": {
    "allow": [
      "Read(~/.claude/**)",
      "Read(~/.gitconfig)",
      "Read(~/.condarc)",
      "Read(~/miniconda3/**)",
      "Read(~/.conda/**)",
      "Read(~/.cache/**)",
      "Read(~/.astropy/**)",
      "Read(~/.config/matplotlib/**)",
      "Read(~/.config/git/**)",
      "Read(~/.ipython/**)",
      "Read(~/.jupyter/**)",
      "Read(~/.local/share/jupyter/**)",
      "Read(~/.Mathematica/**)",
      "Read(~/.Wolfram/**)",
      "Read(~/.matlab/**)",
      "Read(~/.MathWorks/**)",
      "Read(~/.MATLABConnector/**)",
      "Read(~/Documents/MATLAB/**)",
      "Read(~/MATLAB Add-Ons/**)",
      "Read(~/.texlive2023/**)",
      "Read(~/.cargo/**)",
      "Read(~/.rustup/**)",
      "Read(~/.keras/**)",
      "Read(~/nltk_data/**)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/pwd.txt)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.mozilla/**)",
      "Read(~/.thunderbird/**)",
      "Read(~/.local/share/keyrings/**)",
      "Read(~/.cache/mozilla/**)",
      "Read(~/.cache/librewolf/**)",
      "Read(~/.cache/thunderbird/**)",
      "Read(~/.cache/evolution/**)",
      "Read(~/.cache/aerc/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/pwd.txt)",
      "Edit(~/.claude/.credentials.json)",
      "Edit(~/.mozilla/**)",
      "Edit(~/.thunderbird/**)",
      "Edit(~/.local/share/keyrings/**)",
      "Edit(~/.cache/mozilla/**)",
      "Edit(~/.cache/librewolf/**)",
      "Edit(~/.cache/thunderbird/**)",
      "Edit(~/.cache/evolution/**)",
      "Edit(~/.cache/aerc/**)"
    ],
    "ask": [
      "EnterWorktree",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(dangerouslyDisableSandbox:true)"
    ],
    "defaultMode": "plan"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/map-status.sh"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/sandbox-bootstrap.sh"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/setup-changes.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/setup-changes.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/git-guard.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/bg-guard.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/outside-repo-guard.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/hooks/statusline.sh"
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "pypi.org",
        "files.pythonhosted.org",
        "*.anaconda.org",
        "*.anaconda.com",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "bitbucket.org",
        "gitlab.com",
        "codeberg.org",
        "gwosc.org",
        "*.gwosc.org",
        "zenodo.org",
        "arxiv.org",
        "*.arxiv.org",
        "inspirehep.net",
        "mathworks.com",
        "*.mathworks.com"
      ],
      "allowAllUnixSockets": true
    },
    "filesystem": {
      "allowWrite": [
        "~/.conda",
        "~/.cache",
        "~/.astropy",
        "~/.config/matplotlib",
        "~/.ipython",
        "~/.jupyter",
        "~/.local/share/jupyter",
        "~/.Mathematica",
        "~/.Wolfram",
        "~/.matlab",
        "~/.MathWorks",
        "~/.MATLABConnector",
        "~/.texlive2023",
        "/tmp/MathLink",
        "/tmp/MathWorks-1000"
      ],
      "denyWrite": [
        "~/.ipython/profile_default/startup",
        "~/.ipython/profile_default/ipython_config.py",
        "~/.ipython/profile_default/ipython_kernel_config.py",
        "~/.ipython/profile_default/ipython_config.json",
        "~/.ipython/profile_default/ipython_kernel_config.json",
        "~/.jupyter/jupyter_server_config.py",
        "~/.jupyter/jupyter_lab_config.py",
        "~/.jupyter/jupyter_notebook_config.py",
        "~/.jupyter/jupyter_server_config.json",
        "~/.jupyter/jupyter_lab_config.json",
        "~/.jupyter/jupyter_notebook_config.json",
        "~/.jupyter/custom",
        "~/.local/share/jupyter/kernels",
        "~/.local/share/jupyter/labextensions",
        "~/.local/share/jupyter/nbextensions",
        "~/.Mathematica/Kernel",
        "~/.Mathematica/Autoload",
        "~/.Mathematica/Applications",
        "~/.Mathematica/FrontEnd/init.m",
        "~/.Mathematica/Paclets/Repository",
        "~/.matlab/R2024a/javaclasspath.txt"
      ],
      "denyRead": [
        "~/",
        "~/.claude/.credentials.json",
        "/run/user/1000",
        "/tmp/.X11-unix",
        "/tmp/.ICE-unix",
        "/run/dbus/system_bus_socket",
        "/tmp/.mathworks-1000",
        "~/.cache/mozilla",
        "~/.cache/librewolf",
        "~/.cache/thunderbird",
        "~/.cache/evolution",
        "~/.cache/aerc"
      ],
      "allowRead": [
        "~/.claude",
        "~/.gitconfig",
        "~/.condarc",
        "~/miniconda3",
        "~/.conda",
        "~/.cache",
        "~/.astropy",
        "~/.config/matplotlib",
        "~/.config/git",
        "~/.ipython",
        "~/.jupyter",
        "~/.local/share/jupyter",
        "~/.Mathematica",
        "~/.Wolfram",
        "~/.matlab",
        "~/.MathWorks",
        "~/.MATLABConnector",
        "~/Documents/MATLAB",
        "~/MATLAB Add-Ons",
        "~/.texlive2023",
        "~/.cargo",
        "~/.rustup",
        "~/.keras",
        "~/nltk_data"
      ]
    },
    "excludedCommands": []
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "theme": "dark-daltonized"
}
